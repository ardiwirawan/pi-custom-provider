{
  "name": "pi-custom-provider",
  "version": "0.1.0",
  "private": true,
  "description": "A local browser-based custom provider and API-key manager for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "providers", "models"],
  "files": ["src/", "web/", "README.md", "LICENSE", "docs/"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "tsx src/standalone.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "tsx --test test/browser.e2e.ts",
    "verify": "npm run check && npm test && npm run test:ui",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
